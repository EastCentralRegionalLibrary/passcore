<Project Sdk="Microsoft.NET.Sdk.Web">
	<PropertyGroup>
		<DefaultItemExcludes>$(DefaultItemExcludes);**\node_modules\**;node_modules\**</DefaultItemExcludes>
		<Copyright>Copyright (c) 2018-2024 - Unosquare</Copyright>
		<AssemblyName>Unosquare.PassCore.Web</AssemblyName>
		<PackageId>Unosquare.PassCore.Web</PackageId>
		<IsPackable>false</IsPackable>
		<GenerateRuntimeConfigurationFiles>true</GenerateRuntimeConfigurationFiles>
		<RootNamespace>Unosquare.PassCore.Web</RootNamespace>
		<EnableNETAnalyzers>true</EnableNETAnalyzers>
		<AnalysisMode>AllEnabledByDefault</AnalysisMode>
		<EnforceCodeStyleInBuild>true</EnforceCodeStyleInBuild>
		<Nullable>enable</Nullable>
		<GenerateDocumentationFile>true</GenerateDocumentationFile>
	</PropertyGroup>

	<!--
		Provider selection: chooses the target framework, the backend project and the
		#if constant.

		The provider decides the framework, not the other way round. Only the Active
		Directory provider needs net8.0-windows, so only an AD build targets it, and
		this project is single-targeted in every invocation.

		It used to work in reverse: Directory.Build.props expanded TargetFrameworks to
		net8.0;net8.0-windows on Windows hosts and the provider was inferred from
		whichever framework was building. That made the build graph depend on the
		machine rather than on what was being built, and everything awkward about
		building this repository followed from it: `dotnet publish` refused to run
		without -f (NETSDK1129), a Linux solution build failed with NETSDK1005, restore
		wrote assets keyed to the plural property, and the frontend targets below ran
		once per inner build, concurrently on Windows, where two `npm ci` processes
		then raced in one directory and corrupted node_modules.

		Note the behaviour change: AD is no longer implied by the framework, so an AD
		build must ask for it with -p:PASSCORE_PROVIDER=AD. Every workflow already does.
	-->
	<PropertyGroup>
		<PASSCORE_PROVIDER Condition="'$(PASSCORE_PROVIDER)' == ''">LDAP</PASSCORE_PROVIDER>
		<TargetFrameworks />
		<TargetFramework Condition="'$(PASSCORE_PROVIDER)' == 'AD'">net8.0-windows</TargetFramework>
		<TargetFramework Condition="'$(PASSCORE_PROVIDER)' != 'AD'">net8.0</TargetFramework>
		<DefineConstants Condition="'$(PASSCORE_PROVIDER)' == 'LDAP'">$(DefineConstants);PASSCORE_LDAP_PROVIDER</DefineConstants>
		<DefineConstants Condition="'$(PASSCORE_PROVIDER)' == 'DEBUG'">$(DefineConstants);PASSCORE_DEBUG_PROVIDER</DefineConstants>
		<DefineConstants Condition="'$(PASSCORE_PROVIDER)' == 'AD'">$(DefineConstants);PASSCORE_AD_PROVIDER</DefineConstants>
	</PropertyGroup>

	<ItemGroup>
		<PackageReference Include="SimpleBase" />
		<PackageReference Include="zxcvbn-core" />
	</ItemGroup>

	<ItemGroup>
		<Content Remove="ClientApp\**" />
		<Content Include="ClientApp\package.json" />
		<Content Include="ClientApp\tsconfig.json" />
		<Content Update="wwwroot/**/*.map" CopyToPublishDirectory="Never" />
		<None Include="appsettings.json">
			<CopyToOutputDirectory>Always</CopyToOutputDirectory>
		</None>
	</ItemGroup>

	<ItemGroup>
		<ProjectReference Include="..\PwnedPasswordsSearch\PwnedPasswordsSearch.csproj" />
		<ProjectReference Include="..\Unosquare.PassCore.Common\Unosquare.PassCore.Common.csproj" />
	</ItemGroup>

	<ItemGroup Condition="'$(PASSCORE_PROVIDER)' == 'DEBUG'">
		<ProjectReference Include="..\Unosquare.PassCore.PasswordProvider.Debug\Unosquare.PassCore.PasswordProvider.Debug.csproj" />
	</ItemGroup>

	<ItemGroup Condition="'$(PASSCORE_PROVIDER)' == 'LDAP'">
		<ProjectReference Include="..\Zyborg.PassCore.PasswordProvider.LDAP\Zyborg.PassCore.PasswordProvider.LDAP.csproj" />
	</ItemGroup>

	<ItemGroup Condition="'$(PASSCORE_PROVIDER)' == 'AD'">
		<ProjectReference Include="..\Unosquare.PassCore.PasswordProvider\Unosquare.PassCore.PasswordProvider.csproj" />
	</ItemGroup>

	<!--
		npm lifecycle scripts (preinstall, install, postinstall) are disabled during `npm ci` using the ignore-scripts flag
		to prevent malicious dependency hook execution. Only specific packages that genuinely require native compilation
		or native binding builds are explicitly rebuilt via `npm rebuild`:
		- @parcel/watcher: native file-watching binding
		- @swc/core: native compiler binary
		- lmdb: native DB binding (Parcel cache)
		- fsevents: optional native macOS file-system events binding
		- msgpackr-extract: optional native serialization accelerator

		Note: fsevents and msgpackr-extract are optional dependencies (fsevents is darwin-only and msgpackr-extract improves performance)
		which do not affect Linux CI runners, but are included so macOS developers and build-cache performance are preserved.
		This list is valid ONLY for the current package-lock.json and MUST be re-derived whenever the frontend dependency tree
		changes by querying `hasInstallScript` against package-lock.json.
	-->
	<Target Name="NpmInstall" BeforeTargets="Build">
		<Message Importance="high" Text="Performing first-run npm clean install..." />
		<Exec Command="node --version" ContinueOnError="true">
			<Output TaskParameter="ExitCode" PropertyName="NodeExitCode" />
		</Exec>
		<Error Condition="'$(NodeExitCode)' != '0'" Text="Node.js is required to build and run this project. Please install Node.js from https://nodejs.org/ and restart your shell or IDE." />
		<Exec Command="npm --version" ContinueOnError="true">
			<Output TaskParameter="ExitCode" PropertyName="NpmVersionExitCode" />
		</Exec>
		<Error Condition="'$(NpmVersionExitCode)' != '0'" Text="npm is required but was not found. Ensure Node.js is installed correctly." />
		<Exec Command="npm ci --ignore-scripts" WorkingDirectory="ClientApp">
			<Output TaskParameter="ExitCode" PropertyName="NpmExitCode" />
		</Exec>
		<Error Condition="'$(NpmExitCode)' != '0'" Text="Installation failed! npm ci encountered an error (exit code $(NpmExitCode))." />
		<Exec Command="npm rebuild @parcel/watcher @swc/core lmdb fsevents msgpackr-extract" WorkingDirectory="ClientApp">
			<Output TaskParameter="ExitCode" PropertyName="NpmRebuildExitCode" />
		</Exec>
		<Error Condition="'$(NpmRebuildExitCode)' != '0'" Text="Rebuild failed! npm rebuild encountered an error (exit code $(NpmRebuildExitCode))." />
		<Exec Command="npm audit" WorkingDirectory="ClientApp" ContinueOnError="true" />
		<Exec Command="node version-script.mjs" WorkingDirectory="ClientApp" ContinueOnError="true" />
	</Target>

	<Target Name="Parcel" DependsOnTargets="NpmInstall" BeforeTargets="Build">
		<Message Importance="high" Text="Running Parcel build..." />
		<Exec Command="npm run build" WorkingDirectory="ClientApp" />
	</Target>
</Project>
