{
  "AppSettings": {
    "LdapHostnames": [
      "dc.example.com"
    ],
    "LdapPort": 636,
    "LdapSecureSocketLayer": true,
    "LdapStartTls": false,
    "LdapIgnoreTlsValidation": true,
    "LdapChangePasswordWithDelAdd": true,
    "LdapSearchBase": "DC=example,DC=com",
    "LdapSearchFilter": "(sAMAccountName={Username})",
    "LdapUsername": "CN=Administrator,CN=Users,DC=example,DC=com",
    "LdapPassword": "AdminPassword123!",
    "ErrorDisclosureMode": "Informative"
  },
  "ClientSettings": {
    "PasswordProviderOptions": {
      "RestrictedAdGroups": [
        "RestrictedGroup"
      ],
      "AllowedAdGroups": [
        "AllowedGroup"
      ]
    }
  }
}
