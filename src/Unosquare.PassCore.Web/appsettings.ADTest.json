{
  // WHAT THIS CONFIGURATION DOES AND DOES NOT COVER
  //
  // UseAutomaticContext is false here because it has to be: the GitHub runner is
  // not domain-joined, so there is no machine identity to bind as. Production
  // deployments normally run it TRUE. The two take different paths through
  // AcquirePrincipalContext, so be clear about what the smoke test proves.
  //
  // Genuinely covered, and configuration-independent -- the same code runs
  // either way: provider logic, error routing and disclosure posture, policy
  // evaluation order, membership resolution, and the minPwdLength read.
  //
  // NOT covered anywhere, by this job or any other: context construction and
  // channel selection on the automatic-context path. That path calls
  // new PrincipalContext(ContextType.Domain) with no server, credentials or
  // options, and nothing in CI exercises it. The explicit-credentials path it
  // does exercise has already been found broken twice -- the ADSI path defect
  // behind minPwdLength, and the password change that still fails -- so the
  // absence of coverage on the other path is worth holding in mind rather than
  // assuming it is the safer one.
  //
  // See TESTING.md for the same division stated alongside the other suites.
  "AppSettings": {
    "UseAutomaticContext": false,
    "LdapSearchBase": "ou=people,dc=example,dc=com",
    "LdapSecureSocketLayer": false,
    "LdapStartTls": false,
    "LdapChangePasswordWithDelAdd": false,
    "LdapSearchFilter": "(sAMAccountName={Username})",
    "ErrorDisclosureMode": "Informative",
    // The DC's FQDN, not the realm name and not "localhost".
    //
    // A signed-and-sealed bind derives its target service name from whatever is
    // given here, and there is no host service principal for the realm: Samba
    // registers ldap/dc.example.com, not ldap/example.com. The workflow's bind
    // diagnostic shows the difference directly --
    //
    //   sealed bind to example.com:389     failed: credential is invalid
    //   sealed bind to dc.example.com:389  SUCCEEDED
    //
    // -- while LDAPS succeeds for both, because SSL authenticates the channel
    // against the certificate rather than a service principal. With the realm
    // name configured here, every read failed with 0x8007052E, which reads as a
    // wrong password and is really a name that has no principal behind it.
    //
    // Forest discovery is unaffected: it resolves the domain through DNS on its
    // own and does not take this value.
    "LdapHostnames": [ "dc.example.com" ],
    // 389, the documented default. Setting this to 636 has now been tested
    // TWICE and is UNREACHABLE, not merely unhelpful -- do not retry it.
    //
    // The hypothesis was reasonable: IADsUser::ChangePassword opens its own
    // connections rather than reusing the caller's channel, its documented
    // transports include LDAP over SSL, and the DirectoryEntry it operates on
    // carries LDAP://dc.example.com:<port>/... with the port pinned. With 389 in
    // the path the SSL attempt plausibly targets 389 and never gets an SSL
    // connection at all, so pinning 636 should hand it one.
    //
    // It cannot be tested this way, because 636 breaks context acquisition
    // before any password change is attempted. Both channels are refused:
    //
    //   sealed  (Negotiate|Signing|Sealing) on dc.example.com:636
    //     COMException (0x8007203A): The server is not operational.
    //   SSL     (Negotiate|SecureSocketLayer) on dc.example.com:636
    //     DirectoryServicesCOMException (0x80072028): A more secure
    //     authentication method is required for this server.
    //   result: InvalidOperationException: Failed to create PrincipalContext
    //     over either a signed-and-sealed or an SSL channel.
    //
    // EventId 108 did not fire at all -- no channel was ever established -- and
    // 109 fired into a fallback that then failed. The run died at the
    // minPwdLength read, the first assertion, so Test 1 never executed. That was
    // true on the first attempt and it is true again now that the group legs no
    // longer block the job, which was the reason for retrying.
    //
    // The negative is still an answer: if the SSL fallback cannot carry a
    // CONTEXT it cannot carry a password change either. The port hypothesis is
    // unreachable by configuration, and closing it is what makes the explicit-
    // bind limitation a known limitation with an unidentified cause rather than
    // one with an untried fix.
    //
    // Note what this does NOT mean. LDAPS works fine from this runner: the
    // workflow's own probe binds LdapConnection over SSL to dc.example.com:636
    // successfully in the same job. It is ADSI's PrincipalContext with
    // SecureSocketLayer that is refused with 0x80072028
    // (LDAP_STRONG_AUTH_REQUIRED). See TESTING.md, "The AD password change on
    // the explicit-bind path".
    "LdapPort": 389,

    // Resolve the submitted username as a sAMAccountName. The default is
    // UserPrincipalName, and with no DefaultDomain configured
    // FixUsernameWithDomain leaves "testuser" unqualified, which cannot match a
    // UPN and would make every seeded account look nonexistent. The seed script
    // creates these users by sAMAccountName, which is also what the LDAP
    // provider's search filter above matches on.
    "IdTypeForUser": "SAM",

    // NT-style, not a DN. The AD provider hands these to PrincipalContext,
    // which binds through ADSI and expects DOMAIN\\user or user@domain -- a DN
    // such as "cn=admin,ou=people,dc=example,dc=com" is rejected with
    // 0x8007052E "user name or password is incorrect", which reads like a wrong
    // password but is really a wrong username format. The LDAP provider does
    // want a DN, which is where the mismatch came from.
    //
    // Administrator rather than the seeded 'admin' account: this is the service
    // account for the whole run, so it needs to read group memberships and act
    // on other users. Its password is the container's ADMINPASS.
    "LdapUsername": "EXAMPLE\\Administrator",
    "LdapPassword": "AdminPassword123!"
  },
  "ClientSettings": {
    // No group lists here, deliberately -- and this file is not where the
    // smoke test's group lists come from.
    //
    // The workflow's membership legs each need DIFFERENT lists, so they supply
    // them as command-line arguments at launch (see
    // tests/samba-ad/restart-passcore.ps1). Command-line configuration sits last
    // in the chain and wins outright, and it uses ':' as its separator -- '__'
    // is environment-variable syntax and does nothing there.
    //
    // Two reasons this file cannot do the job instead:
    //
    //   * Configuration merges this file onto appsettings.json per key and binds
    //     arrays by index. appsettings.json ships three entries in
    //     RestrictedAdGroups, so omitting the key here leaves those three in the
    //     merged result -- and an explicit [] would too, because it contributes
    //     no indices. An override cannot SHRINK an array. The workflow step
    //     "Clear the shipped group lists from the published configuration"
    //     empties them in the published base file, which is what actually takes
    //     effect and is what makes per-leg lists possible at all.
    //   * A single file cannot express four different configurations anyway.
    //
    // With no lists in force, GroupMembershipPolicy returns before touching the
    // directory. That early return is a real code path rather than a way of
    // skipping one -- it exists so a deployment configuring neither list hands
    // an unauthenticated request no directory work, and it is covered by the
    // unit test WithNoGroupsConfigured_TheDirectoryIsNotQueriedAtAll. It is the
    // state the first three assertions run under, before the legs begin.
    "PasswordProviderOptions": {
    }
  }
}
