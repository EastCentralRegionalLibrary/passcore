{
    "name": "passcore",
    "version": "1.0.0",
    "supportedArchitectures": {
        "os": [
            "linux",
            "darwin",
            "win32"
        ],
        "cpu": [
            "x64"
        ]
    },
    "description": "PassCore is a self-service password change utility for Active Directory.",
    "source": "index.html",
    "scripts": {
        "lint": "tsc --noEmit && eslint . --quiet",
        "lint:fix": "eslint . --quiet --fix",
        "clean": "rimraf ../wwwroot",
        "prestart": "npm run clean",
        "prebuild": "npm run clean",
        "build": "parcel build index.html --dist-dir ../wwwroot --log-level warn",
        "typecheck": "tsc --noEmit",
        "prettier": "prettier --check \"**/*.{ts,tsx,js,json,css,mjs}\"",
        "prettier:fix": "prettier --write \"**/*.{ts,tsx,js,json,css,mjs}\"",
        "start": "parcel index.html --dist-dir ../wwwroot --open --port 4040",
        "test:e2e": "playwright test"
    },
    "repository": {
        "type": "git",
        "url": "git+https://github.com/EastCentralRegionalLibrary/passcore.git"
    },
    "author": "Unosquare",
    "license": "MIT",
    "bugs": {
        "url": "https://github.com/EastCentralRegionalLibrary/passcore/issues"
    },
    "homepage": "https://github.com/EastCentralRegionalLibrary/passcore",
    "alias": {
        "@zxcvbn-ts/dictionary-compression/decompress": "@zxcvbn-ts/dictionary-compression/dist/decompress.mjs",
        "@zxcvbn-ts/dictionary-compression/compress": "@zxcvbn-ts/dictionary-compression/dist/compress.mjs"
    },
    "dependencies": {
        "@emotion/react": "^11.14.0",
        "@emotion/styled": "^11.14.1",
        "@mui/icons-material": "^9.0.0",
        "@mui/material": "^9.0.0",
        "@zxcvbn-ts/core": "^4.1.2",
        "@zxcvbn-ts/language-common": "^4.1.3",
        "@zxcvbn-ts/language-en": "^4.1.1",
        "react": "^19.0.0",
        "react-dom": "^19.0.0"
    },
    "devDependencies": {
        "@eslint/js": "^9.39.4",
        "@playwright/test": "^1.59.1",
        "@types/node": "^22.10.2",
        "@types/react": "^19.0.0",
        "@types/react-dom": "^19.0.0",
        "eslint": "^9.39.4",
        "eslint-plugin-react": "^7.37.5",
        "eslint-plugin-react-hooks": "^5.2.0",
        "globals": "^16.5.0",
        "parcel": "^2.16.4",
        "prettier": "^3.8.3",
        "rimraf": "^6.1.3",
        "typescript": "^5.8.3",
        "typescript-eslint": "^8.58.2"
    }
}
