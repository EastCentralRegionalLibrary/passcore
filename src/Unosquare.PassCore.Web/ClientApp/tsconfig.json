{
    "compilerOptions": {
        // Language
        "target": "ES2020",
        "lib": ["esnext", "dom"],
        "jsx": "react-jsx",
        // Modules
        "module": "esnext",
        "moduleResolution": "bundler",
        "esModuleInterop": true,
        // Type checking
        "strict": true,
        "noImplicitReturns": true,
        "noUnusedLocals": true,
        "forceConsistentCasingInFileNames": true,
        // Emit
        "noEmit": true,
        // Build behavior
        "isolatedModules": true,
        "skipLibCheck": true,
        "types": ["node"]
    },
    "include": ["./**/*"],
    "exclude": ["node_modules"]
}
