<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<Copyright>Copyright (c) 2018-2022 - Unosquare</Copyright>
		<GenerateDocumentationFile>true</GenerateDocumentationFile>
		<!-- Override Directory.Build.props to only target Windows -->
		<TargetFramework>net8.0-windows</TargetFramework>
		<IsTestProject>false</IsTestProject>
		<Nullable>enable</Nullable>
		<EnableNETAnalyzers>true</EnableNETAnalyzers>
		<AnalysisMode>AllEnabledByDefault</AnalysisMode>
		<EnforceCodeStyleInBuild>true</EnforceCodeStyleInBuild>
	</PropertyGroup>

	<!--
	  WINDOWS is deliberately NOT defined here. It follows the target framework, and the
	  .NET SDK already supplies it: any platform specific TFM implicitly defines its
	  platform symbol, so net8.0-windows above yields WINDOWS, WINDOWS7_0 and
	  WINDOWS7_0_OR_GREATER on every host, Linux included. Verified by inspecting the
	  compiler command line, which carries all three.

	  What stood here was a PropertyGroup conditioned on
	  RuntimeInformation.IsOSPlatform(Windows), a BUILD HOST test. Every type in this
	  project sits inside '#if WINDOWS', so if that predicate had been load bearing, a
	  Linux build would have emitted an empty assembly and still exited 0. It was not
	  load bearing, only redundant and misleading, and it is removed rather than
	  retargeted because the obvious retarget does not work: TargetPlatformIdentifier is
	  set by SDK targets imported after this file's body, so a condition on it evaluates
	  against an empty value and silently never fires.

	  Do not reintroduce a DefineConstants check as a guard either. The SDK's implicit
	  constants are merged into the Csc invocation and never appear in the
	  $(DefineConstants) property, so such a guard reads a value that legitimately lacks
	  WINDOWS and fails every build. The real guard against the empty assembly state is
	  the post build symbol check in ci-testing.yml.
	-->


	<ItemGroup>
		<PackageReference Include="Microsoft.Extensions.Options"/>
		<PackageReference Include="Microsoft.Extensions.Logging.Abstractions"/>
		<PackageReference Include="System.DirectoryServices"/>
		<PackageReference Include="System.DirectoryServices.AccountManagement"/>

	</ItemGroup>

	<ItemGroup>
		<ProjectReference Include="..\PwnedPasswordsSearch\PwnedPasswordsSearch.csproj" />
		<ProjectReference Include="..\Unosquare.PassCore.Common\Unosquare.PassCore.Common.csproj" />
	</ItemGroup>

</Project>
