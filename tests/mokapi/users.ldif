sn: legacyuser
userPassword: testpassword
sAMAccountName: legacyuser
memberOf: cn=LegacyGroup,ou=groups,dc=example,dc=com

dn: cn=distributionuser,ou=people,dc=example,dc=com
objectClass: top
objectClass: person
objectClass: organizationalPerson
objectClass: inetOrgPerson
cn: distributionuser
sn: distributionuser
userPassword: testpassword
sAMAccountName: distributionuser
memberOf: cn=DistributionGroup,ou=groups,dc=example,dc=com
